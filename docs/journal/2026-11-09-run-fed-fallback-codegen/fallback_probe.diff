+fn probe_bufs(file: &str, arm: usize, x: &Bufs) {
+    let (llp, llc) = (x.ll.as_ptr() as usize, x.ll.capacity());
+    let ttp = x.tt.as_slice().as_ptr() as usize;
+    let ttl = x.tt.len();
+    let outp = x.out.as_ptr() as usize;
+    let cp = x.counts.as_ptr() as usize;
+    let (llpr, llh) = probe::thp(llp, llc);
+    let (ttpr, tth) = probe::thp(ttp, llc.max(ttl) * 4);
+    let (opr, oh) = probe::thp(outp, x.out.capacity());
+    println!(
+        "PROBE {file} arm {}: ll {llp:#x} cap {llc} (mod4K {:#x}, mod2M {:#x}) {} pages {llpr} thp {llh}; tt {ttp:#x} len {ttl} (mod4K {:#x}, mod2M {:#x}) {} pages {ttpr} thp {tth}; out {outp:#x} cap {} {} pages {opr} thp {oh}; counts {cp:#x} (mod4K {:#x}); tt-ll {:#x} mod4K",
+        ARMS[arm], llp % 4096, llp % (2 << 20), probe::vma(llp),
+        ttp % 4096, ttp % (2 << 20), probe::vma(ttp),
+        x.out.capacity(), probe::vma(outp), cp % 4096,
+        ttp.wrapping_sub(llp) % 4096,
+    );
+}
