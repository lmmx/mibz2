+/// Over a block's MTF symbols (a replay of `mtf::mtf`'s list, untimed): literals, those
+/// with index >= 32 (`mtf_avx2`'s second level, its `rows` stores), and of those, the ones
+/// whose byte's `counts` slot lies in each window [lo, hi) of slots
+fn alias_census(b: &Symbols, wins: &[(usize, usize)]) -> (u64, u64, Vec<u64>, Vec<u64>, Vec<u64>) {
+    let mut list: Vec<u8> = b.seq_to_unseq.to_vec();
+    let (mut lit, mut deep) = (0u64, 0u64);
+    // per window: deep literals whose own byte's slot is in it (`self`); literals whose
+    // slot is in it followed by a deep literal (`pair`: its rows loads after that store);
+    // and literals in it at all (`any`)
+    let (mut own, mut pair, mut any) = (vec![0u64; wins.len()], vec![0u64; wins.len()], vec![0u64; wins.len()]);
+    let mut prev: Option<u8> = None;
+    for &s in &b.syms {
+        if s <= 1 { continue; }
+        if s == b.eob { break; }
+        let nn = (s as usize - 1).min(255);
+        let c = list[nn];
+        list.remove(nn);
+        list.insert(0, c);
+        lit += 1;
+        for (k, &(lo, hi)) in wins.iter().enumerate() {
+            let inw = (lo..hi).contains(&(c as usize));
+            if inw { any[k] += 1; }
+            if nn >= 32 && inw { own[k] += 1; }
+            if nn >= 32 && prev.is_some_and(|p| (lo..hi).contains(&(p as usize))) { pair[k] += 1; }
+        }
+        if nn >= 32 { deep += 1; }
+        prev = Some(c);
+    }
+    (lit, deep, own, pair, any)
+}
