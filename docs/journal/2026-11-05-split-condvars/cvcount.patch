diff --git a/examples/cvcount.rs b/examples/cvcount.rs
new file mode 100644
index 00000000..1a32f863
--- /dev/null
+++ b/examples/cvcount.rs
@@ -0,0 +1,26 @@
+use std::io::Read;
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let data = std::fs::read(&a[1]).unwrap();
+    for &t in &[2usize, 4] {
+        for round in 0..3 {
+            mibz2::parallel::cvcount::reset();
+            let t0 = std::time::Instant::now();
+            let mut r = mibz2::BzReader::parallel(std::io::Cursor::new(data.clone()), t);
+            let mut buf = vec![0u8; 1 << 20];
+            let mut n = 0u64;
+            loop {
+                let k = r.read(&mut buf).unwrap();
+                if k == 0 { break; }
+                n += k as u64;
+            }
+            let wall = t0.elapsed().as_secs_f64();
+            let c = mibz2::parallel::cvcount::get();
+            println!(
+                "t{t} r{round} wall {wall:.3}s out {n} | reader waits {} wasted {} ({:.0}%) wait {:.1} ms | scanner waits {} wasted {} ({:.0}%) wait {:.1} ms | notify_all: worker {} reader {}",
+                c[0], c[1], 100.0 * c[1] as f64 / c[0].max(1) as f64, c[2] as f64 / 1e6,
+                c[3], c[4], 100.0 * c[4] as f64 / c[3].max(1) as f64, c[5] as f64 / 1e6, c[6], c[7]
+            );
+        }
+    }
+}
