+        })
+    }));
+    #[cfg(feature = "phase-counters")]
+    crate::phase::whole_end();
+    mark!(
+        DecodeEnd,
+        place,
+        res.as_ref().map_or(0, |r| r.as_ref().map_or(0, Vec::len)),
+        res.as_ref()
+            .map_or(0, |r| r.as_ref().map_or(0, Vec::capacity))
+    );
+    let res = match res {
+        Ok(r) => r,
+        Err(p) => {
+            *scratch = Scratch::default();
+            Err(ErrorKind::Internal(panic_message(p)))
         }
     }
+    .map_err(|kind| Error {
+        kind,
+        block: Some(place),
+        bit: Some(bit),
