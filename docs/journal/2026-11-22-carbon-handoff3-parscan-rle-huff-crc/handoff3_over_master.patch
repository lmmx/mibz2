+            let mut st = shared.lock();
+            if syms.capacity() > 0 && st.free_syms.len() < slots {
+                st.free_syms.push(syms);
+            }
+            if n >= POOLED_FROM {
+                st.free_out
+                    .pop()
+                    .unwrap_or_else(|| Vec::with_capacity(n + n / 16 + 64))
+            } else {
