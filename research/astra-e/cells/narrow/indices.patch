+#[cfg(test)]
+mod width_checks {
+    use super::Links;
+    fn round_trip<B: Links>(first: usize, second: usize, width: usize) {
+        let pair = B::pair(first, second);
+        assert_eq!(pair.previous(), first);
+        assert_eq!(pair.top(), second);
+        let meta = B::meta(first, width, second);
+        assert_eq!(B::predecessor(meta), first);
+        assert_eq!(B::rows(meta), width);
+        assert_eq!(B::opposite(meta), second);
+    }
+
+    #[test]
+    fn slot_pair_and_width_are_independent() {
+        for x in [0, 1, 65534, 65535] {
+            for y in [0, 1, 65534, 65535] {
+                for rows in [1, 65535, 65536, 900000] {
+                    round_trip::<u32>(x, y, rows);
+                    round_trip::<u64>(x, y, rows);
+                }
+            }
+        }
+        round_trip::<u64>(65536, 65535, 1);
+        round_trip::<u64>(899999, 65536, 900000);
+    }
+}
