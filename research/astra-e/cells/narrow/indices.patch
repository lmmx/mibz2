+impl Links for u32 {
+    fn pair(previous: usize, top: usize) -> Self {
+        previous as u32 | (top as u32) << 16
+    }
+    fn previous(self) -> usize {
+        self as u16 as usize
+    }
+    fn top(self) -> usize {
+        (self >> 16) as usize
+    }
+    fn meta(previous: usize, rows: usize, opposite: usize) -> u64 {
+        previous as u64 | (opposite as u64) << 16 | (rows as u64) << 32
+    }
+    fn predecessor(meta: u64) -> usize {
+        meta as u16 as usize
+    }
+    fn rows(meta: u64) -> usize {
+        (meta >> 32) as usize
+    }
+    fn opposite(meta: u64) -> usize {
+        (meta >> 16) as u16 as usize
+    }
+}
+
+impl Links for u64 {
+    fn pair(previous: usize, top: usize) -> Self {
+        previous as u64 | (top as u64) << 32
+    }
+    fn previous(self) -> usize {
+        self as u32 as usize
+    }
+    fn top(self) -> usize {
+        (self >> 32) as usize
+    }
+    fn meta(previous: usize, rows: usize, opposite: usize) -> u64 {
+        previous as u64 | (rows as u64) << BITS | (opposite as u64) << (2 * BITS)
+    }
+    fn predecessor(meta: u64) -> usize {
+        (meta & MASK) as usize
+    }
+    fn rows(meta: u64) -> usize {
+        ((meta >> BITS) & MASK) as usize
+    }
+    fn opposite(meta: u64) -> usize {
+        (meta >> (2 * BITS)) as usize
+    }
 }
 
