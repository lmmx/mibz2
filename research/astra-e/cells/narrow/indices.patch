+// The compact order is admitted after counting every real letter, including
+// the split at the primary. Indices are zero based; no sentinel uses a slot.
+trait Links: Copy {
+    fn pair(previous: usize, top: usize) -> Self;
+    fn previous(self) -> usize;
+    fn top(self) -> usize;
+    fn meta(previous: usize, rows: usize, opposite: usize) -> u64;
+    fn predecessor(meta: u64) -> usize;
+    fn rows(meta: u64) -> usize;
+    fn opposite(meta: u64) -> usize;
 }
 
-fn pair(previous: usize, top: usize) -> u64 {
