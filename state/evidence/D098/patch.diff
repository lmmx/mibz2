+
+/// `fill_share` in scalar code: each entry stored alone
+///
+/// # Safety
+///
+/// As `fill_share`, for rows `row .. row_end`; `row <= row_end`, and `next[c] <= lim[c]`
+/// for every byte.
+unsafe fn fill_share_scalar(
+    runs: &[u16],
+    row: u32,
+    row_end: u32,
+    mut next: [u32; 256],
+    lim: &[u32; 256],
+    out: *mut u32,
